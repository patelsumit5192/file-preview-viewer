    "react-file-preview",
    "vue-file-preview",
    "vue-file-viewer",
    "vue-doc-viewer",
    "ngx-doc-viewer",
    "angular-file-viewer",
    "angular-file-preview",
    "pdf-viewer",
    "pdf-preview",
    "pdfjs",
    "docx-preview",
    "docx-viewer",
    "word-viewer",
    "office-viewer",
    "excel-preview",
    "excel-viewer",
    "xlsx-viewer",
    "spreadsheet-viewer",
    "pptx-preview",
    "pptx-viewer",
    "powerpoint-viewer",
    "presentation-viewer",
    "csv-viewer",
    "tsv-viewer",
