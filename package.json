{
  "name": "@patel.sumit51/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Universal file preview library — framework-agnostic, plugin-based, 100% client-side",
  "keywords": [
    "file-preview",
    "document-viewer",
    "pdf-viewer",
    "image-preview",
    "react",
    "vue",
    "angular"
  ],
  "author": "Sumit",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
